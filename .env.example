# Copy to .env and replace every placeholder. Never commit real credentials.
NODE_ENV=development
PORT=3000

# MySQL 8+ connection used by the server and versioned migration runner.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=nextgen
MYSQL_PASSWORD=replace-with-a-strong-password
MYSQL_DATABASE=nextgen_workshop_db
MYSQL_CONNECTION_LIMIT=10

# Generate with:
# node -e "console.log(require('node:crypto').randomBytes(64).toString('base64'))"
# Must be at least 32 bytes. Changing it invalidates all issued JWTs.
NEXTGEN_JWT_SECRET=replace-with-a-random-base64-secret

# Python interpreter used by the local scikit-learn diagnosis service.
# Leave unset to use "python" on Windows and "python3" elsewhere.
# PYTHON_EXECUTABLE=C:\Python312\python.exe

# Optional external VIN decoder. Without it, /api/twin/vin-decode uses only its cache
# and returns 503 for a VIN that has not been decoded before.
# NEXTGEN_VIN_PROVIDER_URL=https://vendor.example/vin
# NEXTGEN_VIN_PROVIDER_KEY=replace-with-vendor-key

# Reverse-proxy use only. npm start already passes --production.
# NODE_ENV=production
